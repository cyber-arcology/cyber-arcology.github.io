---
// The cyber-arcology layer diagram. Inline SVG so it scales to the content column and takes
// its colors from Starlight's theme variables, which flip with `data-theme`.
---

<figure class="layers">
	<svg viewBox="0 0 720 560" role="img" aria-labelledby="layers-title layers-desc">
		<title id="layers-title">cyber-arcology layers</title>
		<desc id="layers-desc">
			Products (cyberfleet, Command Center) depend on Process (cyber-truss, cyber-sdd),
			Communication (cynapse) and Runtime (cyberlegion). Process depends on Communication.
			Runtime depends on Communication and on cyber-mux. Communication refers to the stores.
		</desc>
		<defs>
			<marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 10 5 0 10z" class="head" />
			</marker>
		</defs>

		<rect class="box accent" x="20" y="20" width="680" height="70" rx="8" />
		<text class="layer" x="36" y="44">PRODUCTS</text>
		<text class="name" x="36" y="72">cyberfleet</text>
		<text class="note" x="140" y="72">Operator · Captain · Pod · sorties</text>
		<text class="name" x="440" y="72">Command Center</text>
		<text class="note" x="590" y="72">(planned)</text>

		<rect class="box" x="20" y="130" width="240" height="60" rx="8" />
		<text class="layer" x="36" y="152">PROCESS</text>
		<text class="name" x="36" y="177">cyber-truss · cyber-sdd</text>

		<rect class="box" x="20" y="230" width="320" height="130" rx="8" />
		<text class="layer" x="36" y="252">COMMUNICATION</text>
		<text class="name" x="36" y="278">cynapse</text>
		<text class="note" x="36" y="302">channels, entries, read positions</text>
		<text class="note" x="36" y="324">addressing, coordination claims</text>
		<text class="note" x="36" y="346">Cortex (viewer)</text>

		<rect class="box" x="380" y="230" width="320" height="130" rx="8" />
		<text class="layer" x="396" y="252">RUNTIME</text>
		<text class="name" x="396" y="278">cyberlegion</text>
		<text class="note" x="396" y="302">units, spawn, stop, restart, nudge</text>
		<text class="note" x="396" y="324">doorbell, presence, leases</text>
		<text class="note" x="396" y="346">workspaces</text>

		<rect class="box" x="20" y="400" width="320" height="70" rx="8" />
		<text class="layer" x="36" y="422">STORES</text>
		<text class="note" x="36" y="452">GitHub · Asana · Slack · Figma · Linear</text>

		<rect class="box" x="380" y="400" width="320" height="70" rx="8" />
		<text class="layer" x="396" y="422">PANES</text>
		<text class="name" x="396" y="452">cyber-mux</text>
		<text class="note" x="490" y="452">tmux, herdr, WezTerm…</text>

		<rect class="box dashed" x="20" y="500" width="680" height="44" rx="8" />
		<text class="layer" x="36" y="527">MODEL</text>
		<text class="note" x="96" y="527">dna</text>
		<text class="layer" x="300" y="527">FOUNDATION</text>
		<text class="note" x="390" y="527">agent-harness · universal-plugin</text>

		<g class="edge">
			<line x1="140" y1="90" x2="140" y2="128" marker-end="url(#arrow)" />
			<line x1="300" y1="90" x2="300" y2="228" marker-end="url(#arrow)" />
			<line x1="540" y1="90" x2="540" y2="228" marker-end="url(#arrow)" />
			<line x1="140" y1="190" x2="140" y2="228" marker-end="url(#arrow)" />
			<line x1="380" y1="295" x2="342" y2="295" marker-end="url(#arrow)" />
			<line x1="180" y1="360" x2="180" y2="398" marker-end="url(#arrow)" />
			<line x1="540" y1="360" x2="540" y2="398" marker-end="url(#arrow)" />
		</g>
		<text class="edge-label" x="190" y="384">refers to</text>
	</svg>
	<figcaption>An arrow means <em>depends on</em>. Nothing may depend on a layer above it.</figcaption>
</figure>

<style>
	.layers {
		margin: 1.5rem 0;
	}
	svg {
		width: 100%;
		height: auto;
		font-family: var(--sl-font);
	}
	.box {
		fill: var(--sl-color-bg-nav);
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}
	.box.accent {
		stroke: var(--sl-color-accent);
	}
	.box.dashed {
		fill: none;
		stroke-dasharray: 6 5;
	}
	.layer {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.08em;
	}
	.name {
		fill: var(--sl-color-white);
		font-size: 16px;
		font-weight: 600;
	}
	.note {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
	}
	.edge line {
		stroke: var(--sl-color-accent);
		stroke-width: 1.75;
	}
	.head {
		fill: var(--sl-color-accent);
	}
	.edge-label {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
	}
	figcaption {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		margin-top: 0.5rem;
	}
</style>
